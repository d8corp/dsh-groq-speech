{
  "name": "dsh-groq-speech",
  "version": "0.0.1",
  "description": "Groq Whisper recognizer for DSH voice input, with optional LLM polish and key management via Settings → Models.",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "author": "Mikhail Lysikov <d8corp@mail.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/d8corp/dsh-groq-speech.git"
  },
  "keywords": [
    "DeepSeek",
    "Harness",
    "Groq",
    "Whisper",
    "speech",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/d8corp/dsh-groq-speech/issues"
  },
  "homepage": "https://github.com/d8corp/dsh-groq-speech",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:theme && npm run build:client && innetjs release -tc -lc -e",
    "build:client": "innetjs build -i client -tc -lc -e",
    "build:theme": "innetjs run buildEnv.ts -e",
    "release": "npm run build:theme && npm run build:client && innetjs release -p -tc -lc -e",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dsh": {
    "manifestVersion": "1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}