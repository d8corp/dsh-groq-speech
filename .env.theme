DSH_PLUGIN_GROQ_SPEECH_CSS='.gqs-section{color:var(--dsw-alias-label-primary);display:flex;flex-direction:column;font-size:14px;line-height:22px;width:100%}.gqs-row{align-items:center;border-bottom:.5px solid var(--dsw-alias-border-l2);display:flex;gap:8px;padding:16px 0}.gqs-row:last-of-type{border-bottom:none}.gqs-text{flex:1;flex-direction:column;gap:4px;padding-right:48px}.gqs-text,.gqs-titleRow{display:flex;min-width:0}.gqs-titleRow{align-items:center;flex-wrap:wrap;gap:8px}.gqs-title{color:var(--dsw-alias-label-primary);font-size:14px;font-weight:400;line-height:22px}.gqs-badge{align-items:center;border:.5px solid transparent;border-radius:999px;display:inline-flex;flex:none;font-size:11px;font-weight:500;gap:5px;line-height:17px;padding:1px 8px;white-space:nowrap}.gqs-badge-on{border-color:var(--dsw-alias-state-success-primary);color:var(--dsw-alias-state-success-primary)}.gqs-badge-off,.gqs-badge-on{background:var(--dsw-alias-bg-module-platform)}.gqs-badge-off{border-color:var(--dsw-alias-state-error-primary);color:var(--dsw-alias-state-error-primary)}.gqs-dot{background:currentColor;border-radius:50%;flex:none;height:6px;width:6px}.gqs-desc{color:var(--dsw-alias-label-tertiary);font-size:12px;font-weight:400;line-height:18px;white-space:pre-line}.gqs-desc code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px}.gqs-control{flex:none;gap:8px;min-width:0}.gqs-actions,.gqs-control{align-items:center;display:flex}.gqs-actions{flex-wrap:wrap;gap:12px;justify-content:flex-end}.gqs-link{color:var(--dsw-alias-link);cursor:pointer;font:inherit;text-decoration:none;white-space:nowrap}.gqs-link:hover{text-decoration:underline}.gqs-selectWrap{align-items:center;display:inline-flex;min-width:0;position:relative}.gqs-select{appearance:none;-webkit-appearance:none;background:var(--dsw-alias-bg-module-platform);border:none;border-radius:var(--dsw-radius-md);box-sizing:border-box;color:var(--dsw-alias-label-primary);cursor:pointer;font:inherit;font-size:14px;height:36px;line-height:22px;max-width:320px;padding:0 36px 0 14px}.gqs-select:hover:not(:disabled){background:var(--dsw-alias-interactive-bg-hover)}.gqs-select:disabled{cursor:default;opacity:.5}.gqs-select:focus-visible{outline:var(--dsw-focus-ring-width,2px) solid var(--dsw-focus-ring-color,var(--dsw-alias-state-business-primary));outline-offset:2px}.gqs-chevron{color:var(--dsw-alias-label-caption);flex:none;pointer-events:none;position:absolute;right:12px}.gqs-textarea{background:var(--dsw-alias-bg-module-platform);border:.5px solid var(--dsw-alias-border-l4);border-radius:var(--dsw-radius-md);box-sizing:border-box;color:var(--dsw-alias-label-primary);font:inherit;font-size:14px;line-height:22px;min-height:96px;outline:none;padding:8px 12px;resize:vertical;width:100%}.gqs-textarea::placeholder{color:var(--dsw-alias-label-caption)}.gqs-textarea:focus{border-color:var(--dsw-alias-state-business-primary);box-shadow:inset 0 0 0 .5px var(--dsw-alias-state-business-primary)}.gqs-button{align-items:center;border:none;border-radius:var(--dsw-radius-md);box-sizing:border-box;cursor:pointer;display:inline-flex;font:inherit;font-size:14px;gap:6px;height:36px;justify-content:center;line-height:22px;padding:0 14px;white-space:nowrap}.gqs-button:disabled{cursor:default;opacity:.4}.gqs-button:focus-visible{outline:var(--dsw-focus-ring-width,2px) solid var(--dsw-focus-ring-color,var(--dsw-alias-state-business-primary));outline-offset:2px}.gqs-primary{background:var(--dsw-alias-button-primary-fill);color:var(--dsw-alias-label-primary-foreground);font-weight:500}.gqs-primary:hover:not(:disabled){background:var(--dsw-alias-button-primary-hover)}.gqs-secondary{background:transparent;border:.5px solid var(--dsw-alias-border-l3);color:var(--dsw-alias-label-primary)}.gqs-secondary:hover:not(:disabled){background:var(--dsw-alias-interactive-bg-hover)}.gqs-compact{font-size:12px;height:28px;line-height:18px;padding:0 10px}.gqs-row-prompt{align-items:stretch;flex-direction:column;gap:10px}.gqs-row-prompt .gqs-text{padding-right:0}.gqs-footer{align-items:center;display:flex;gap:16px;padding:16px 0 0}.gqs-footer .gqs-notice{flex:1;min-width:0}.gqs-footer .gqs-button{margin-left:auto}.gqs-notice{font-size:12px;line-height:18px;margin:0}.gqs-notice-success{color:var(--dsw-alias-state-success-primary)}.gqs-notice-error{color:var(--dsw-alias-state-error-primary)}.gqs-loading{border-bottom:.5px solid var(--dsw-alias-border-l2);color:var(--dsw-alias-label-tertiary);font-size:12px;line-height:18px;padding:16px 0}@media (max-width:640px){.gqs-row{flex-wrap:wrap}.gqs-text{flex-basis:100%;padding-right:0}.gqs-control{align-items:stretch;width:100%}.gqs-actions{justify-content:flex-start;width:100%}.gqs-select,.gqs-selectWrap{max-width:none;width:100%}}'