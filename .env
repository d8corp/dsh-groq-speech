INNETJS_ENV_PREFIX=DSH_PLUGIN_GROQ_SPEECH_
__ENV_EXTENDS=.env.theme
RELEASE_COPY_FILES={cordis.patch.yml,client/**/*,locale/**/*,icon.png}
BUILD_FOLDER=client
RELEASE_TSCONFIG=tsconfig.release.json
BUILD_FORMAT=cjs
BUILD_BANNER="window.__ModuleLoader__.load({id:'dsh-groq-speech',factory(require){var module={exports:{}};var exports=module.exports;"
BUILD_FOOTER="return module.exports}});"
BUILD_EXTERNAL=react,react/jsx-runtime
